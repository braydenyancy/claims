# Development defaults, for reference. compose.yaml sets these for the
# containers; nothing reads a .env file. Export them in your shell if you
# run the backend outside compose.
POSTGRES_DB=claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=claims
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1
